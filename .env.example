# DATABASE 
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# CORS 
CORS_ORIGINS="http://localhost:3000,http://localhost:3300"
CORS_ORIGIN="http://localhost:3000"

# JWT 
EXPIRES_IN_ACCESSTOKEN="1h"
EXPIRES_IN_REFRESHTOKEN="1d"
SERECT_KEY_ACCESSTOKEN="your_access_token_secret_key"
SERECT_KEY_REFRESHTOKEN="your_refresh_token_secret_key"

# MAIL 
MAIL_USER="your_email@gmail.com"
MAIL_PASS="your_email_app_password"
OTP_EXPIRES_IN="5m"

# SEPAY
PAYMENT_API_KEY="your_payment_api_key"
APP_NAME="FastE-Ecommerce"
ENCRYPTION_KEY="your_encryption_key_32_bytes_in_hex"

# GOOGLE AUTH
GOOGLE_SCOPES_API="https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile"
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
GOOGLE_CLIENT_REDIRECT_URI="http://localhost:3300/oauth-google-callback"

# AWS S3 
AWS_S3_PUBLIC_BUCKET="your_s3_bucket_name"
AWS_S3_REGION="ap-southeast-1"
AWS_S3_ACCESS_KEY_ID="your_aws_access_key_id"
AWS_S3_SECRET_ACCESS_KEY="your_aws_secret_access_key"

# RENDER API (optional)
RENDER_API_KEY="your_render_api_key"

# REDIS 
REDIS_URL="redis://127.0.0.1:6379"

# RABBITMQ / AMQP
AMQP_URL="amqp://localhost"

# ELASTICSEARCH
ELASTICSEARCH_NODE="https://localhost:9200"
ELASTICSEARCH_APIKEY="your_elasticsearch_api_key"

# CLOUDINARY 
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# RECAPTCHA
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key"

# CRON
CRON_ENABLED=true
